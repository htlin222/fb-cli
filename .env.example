# Copy to .env and fill in. Never commit the real .env.
#
# From the Meta App Dashboard (https://developers.facebook.com/apps/)
# -> Facebook Login for Business / Facebook Login -> Settings
FB_APP_ID=
FB_APP_SECRET=

# The redirect URI registered in the same Login Settings page.
# Must be HTTPS and match EXACTLY (no trailing slash drift).
# After `make worker-deploy` this should be: https://<your-worker>.workers.dev/callback
FB_REDIRECT_URI=
FB_WORKER_BASE=

# Populated automatically by `make auth` / `make refresh` -- leave empty on first run.
FB_USER_ACCESS_TOKEN=
FB_USER_TOKEN_EXPIRES_AT=
FB_PAGE_ID=
FB_PAGE_NAME=
FB_PAGE_ACCESS_TOKEN=

# Shared secret between Meta's webhook handshake, the CF Worker, and the CLI.
# Set via:
#   TOK=$(openssl rand -hex 32) && echo "$TOK" | wrangler secret put FB_WEBHOOK_VERIFY_TOKEN
# then paste the same value here (or use the same TOK to update both).
# Worker also needs FB_APP_SECRET set:
#   grep '^FB_APP_SECRET=' .env | cut -d= -f2- | wrangler secret put FB_APP_SECRET
FB_WEBHOOK_VERIFY_TOKEN=
